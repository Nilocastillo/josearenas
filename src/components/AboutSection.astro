<section
	id="estudio"
	aria-labelledby="about-title"
	class="relative mx-[10px] mb-[10px] min-h-[760px] overflow-hidden border border-[#33291f]/10 bg-[#e9e0d4] px-6 py-8 text-[#201b17] lg:mx-[18px] lg:mb-[18px] lg:min-h-[850px] lg:px-[clamp(4rem,7vw,8rem)] lg:py-16"
>
	<div
		class="pointer-events-none absolute inset-0 opacity-[0.16]"
		aria-hidden="true"
		style="background-image: linear-gradient(rgba(54,43,33,.15) 1px, transparent 1px), linear-gradient(90deg, rgba(54,43,33,.15) 1px, transparent 1px); background-size: 72px 72px;"
	></div>
	<div
		class="pointer-events-none absolute inset-0 opacity-[0.06] mix-blend-multiply"
		aria-hidden="true"
		style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.2'/%3E%3C/svg%3E&quot;);"
	></div>

	<!-- Sistema cartesiano inspirado en un plano de replanteo -->
	<div class="pointer-events-none absolute bottom-0 left-[68%] top-0 hidden border-l border-[#6d5947]/25 lg:block" aria-hidden="true">
		<span class="absolute -left-[3px] top-[18%] size-[5px] bg-[#a87343]"></span>
		<span class="absolute -left-[4px] top-[42%] h-px w-2 bg-[#6d5947]/40"></span>
		<span class="absolute -left-[4px] top-[66%] h-px w-2 bg-[#6d5947]/40"></span>
		<span class="absolute left-3 top-[18%] text-[0.48rem] font-bold tracking-[0.18em] text-[#6d5947]/65">Y 12.00</span>
	</div>
	<div class="pointer-events-none absolute left-0 right-0 top-[71%] hidden border-t border-[#6d5947]/25 lg:block" aria-hidden="true">
		<span class="absolute left-[18%] -top-1 h-2 w-px bg-[#6d5947]/40"></span>
		<span class="absolute left-[43%] -top-1 h-2 w-px bg-[#6d5947]/40"></span>
		<span class="absolute left-[68%] -top-[3px] size-[5px] -translate-x-1/2 bg-[#a87343]"></span>
		<span class="absolute right-8 top-3 text-[0.48rem] font-bold tracking-[0.18em] text-[#6d5947]/65">X 24.00</span>
	</div>

	<div class="relative z-[1] flex items-center justify-between border-b border-[#33291f]/20 pb-5">
		<p class="flex items-center gap-3 text-[0.58rem] font-bold uppercase tracking-[0.24em]">
			<span class="block h-px w-7 bg-[#a87343]"></span>
			02 / El estudio
		</p>
		<p class="hidden text-[0.55rem] font-semibold uppercase tracking-[0.22em] text-[#56483c]/65 sm:block">Eje 01 — Origen</p>
	</div>

	<div class="relative z-[1] grid min-h-[650px] grid-rows-[auto_1fr_auto] pt-12 lg:min-h-[710px] lg:pt-16">
		<div class="grid gap-6 lg:grid-cols-12">
			<div class="lg:col-span-10">
				<p class="mb-3 text-[0.57rem] font-bold uppercase tracking-[0.26em] text-[#6b5848]">Identidad / 01</p>
				<h2 id="about-title" class="max-w-[1100px] text-[clamp(3.5rem,8.6vw,9.4rem)] font-light leading-[0.8] tracking-[-0.065em]">
					José Arenas<br />
					<em class="ml-[0.05em] [font-family:var(--grotesk)] font-[520] not-italic tracking-[-0.065em]">Arquitecto</em>
				</h2>
			</div>
			<div class="hidden justify-end lg:col-span-2 lg:flex">
				<div class="mt-3 grid h-20 w-24 grid-cols-4 grid-rows-3 border-l border-t border-[#33291f]/25" aria-hidden="true">
					<span class="col-span-1 row-span-2 border-b border-r border-[#33291f]/25"></span>
					<span class="col-span-2 border-b border-r border-[#33291f]/25"></span>
					<span class="border-b border-r border-[#33291f]/25"></span>
					<span class="col-span-3 row-span-2 border-b border-r border-[#33291f]/25"></span>
				</div>
			</div>
		</div>

		<div class="grid content-center gap-9 py-12 md:grid-cols-12 md:gap-8 lg:py-14">
			<div class="hidden md:col-span-3 md:block">
				<p class="max-w-[150px] text-[0.55rem] font-bold uppercase leading-[1.8] tracking-[0.2em] text-[#665546]">
					Arquitectura<br />Construcción<br />Diseño integral
				</p>
			</div>
			<div class="md:col-span-5 md:col-start-5">
				<p class="[font-family:var(--serif)] text-[clamp(1.45rem,2.2vw,2.25rem)] leading-[1.23] tracking-[-0.025em]">
					Somos una empresa especializada en el desarrollo integral de{' '}
					<em class="[font-family:var(--grotesk)] font-[520] not-italic tracking-[-0.035em]">proyectos arquitectónicos y de construcción.</em>
				</p>
			</div>
			<div class="md:col-span-3 md:col-start-10">
				<p class="text-[0.92rem] leading-[1.65] text-[#4f4237]">
					Desarrollamos propuestas innovadoras y creativas para cada cliente. Nuestro objetivo es crear espacios que mejoren su calidad de vida, uniendo sensibilidad, funcionalidad y una ejecución rigurosa.
				</p>
			</div>
		</div>

		<div class="flex justify-end border-t border-[#33291f]/20 pt-6">
			<a class="group inline-flex w-fit items-center gap-8 border border-[#201b17] bg-[#201b17] px-6 py-4 text-[0.62rem] font-bold uppercase tracking-[0.2em] text-[#eee4d8] transition duration-300 hover:-translate-y-1 hover:bg-[#a87343]" href="#proyectos">
				Ver proyectos
				<svg class="size-3.5 fill-none stroke-current stroke-[1.5] transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" aria-hidden="true">
					<path d="M2 8h12M9 3l5 5-5 5"></path>
				</svg>
			</a>
		</div>
	</div>
</section>
